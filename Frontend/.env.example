# Existing Cognito authentication settings
VITE_COGNITO_USER_POOL_ID=us-east-1_example
VITE_COGNITO_CLIENT_ID=exampleclientid

# Optional but recommended for production. When set, only members of this
# Cognito group can complete the admin login flow.
VITE_COGNITO_ADMIN_GROUP=admin

# API Gateway stage URL from: terraform output -raw api_base_url
VITE_API_BASE_URL=https://example.execute-api.us-east-1.amazonaws.com/dev

# Public dish-image base URL from: terraform output -raw dish_images_base_url
# This is separate from the CloudFront distribution that hosts the React build.
# Do not include a trailing slash.
VITE_DISH_IMAGES_BASE_URL=https://images.example.com
